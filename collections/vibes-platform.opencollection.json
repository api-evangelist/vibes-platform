          },
          "http": {
            "method": "GET",
            "url": "https://public-api.vibescm.com/companies/:company_key/callbacks",
            "params": [
              {
                "name": "company_key",
                "value": "",
                "type": "path",
                "description": "Your Vibes company identifier."
              }
            ]
          },
          "docs": "Retrieve all registered callback endpoints for the company."
        },
        {
          "info": {
            "name": "Register Callback",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://public-api.vibescm.com/companies/:company_key/callbacks",
            "params": [
              {
                "name": "company_key",
                "value": "",
