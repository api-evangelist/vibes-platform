                "description": "Your Vibes company identifier."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Register a new callback endpoint for opt-in or delivery status notifications."
        }
      ]
    }
  ],
  "bundled": true
}